{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Football Shop{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    Admin Dashboard
                </h2>
                <div class="text-muted mt-1">Manage your football shop products</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a href="{{ path('admin_product_new') }}" class="btn btn-primary d-none d-sm-inline-block">
                        <i class="ti ti-plus"></i>
                        Add Product
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        {% if products|length > 0 %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Team</th>
                                <th>Size</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in products %}
                                <tr>
                                    <td>
                                        <div class="d-flex py-1 align-items-center">
                                            <span class="avatar me-2" 
                                                  style="{% if product.image %}background-image: url('{{ product.image }}'); background-size: cover;{% else %}background: linear-gradient(45deg, #f8f9fa 25%, transparent 25%);{% endif %}"></span>
                                            <div class="flex-fill">
                                                <div class="font-weight-medium">{{ product.name }}</div>
                                                <div class="text-muted">{{ product.season }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted">
                                        {{ product.team }}
                                    </td>
                                    <td class="text-muted">
                                        {{ product.size }}
                                    </td>
                                    <td class="text-muted">
                                        €{{ product.price|number_format(2, '.', ',') }}
                                    </td>
                                    <td class="text-muted">
                                        {{ product.stock }}
                                    </td>
                                    <td>
                                        {% if product.active %}
                                            <span class="badge bg-success me-1"></span>
                                            Active
                                        {% else %}
                                            <span class="badge bg-secondary me-1"></span>
                                            Inactive
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            <a href="{{ path('admin_product_edit', {id: product.id}) }}" class="btn btn-white btn-sm">
                                                Edit
                                            </a>
                                            <form method="post" action="{{ path('admin_product_delete', {id: product.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this product?')">
                                                <button type="submit" class="btn btn-white btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <div class="empty">
                <div class="empty-img">
                    <img src="data:image/svg+xml;base64," alt="" height="64">
                </div>
                <p class="empty-title">No products found</p>
                <p class="empty-subtitle text-muted">
                    You haven't added any products yet. Create your first product to get started.
                </p>
                <div class="empty-action">
                    <a href="{{ path('admin_product_new') }}" class="btn btn-primary">
                        <i class="ti ti-plus"></i>
                        Add your first product
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}