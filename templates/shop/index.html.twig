{% extends 'base.html.twig' %}

{% block title %}Football Shop - Home{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    Football Jerseys Collection
                </h2>
                <div class="text-muted mt-1">Discover our premium collection of football jerseys</div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        {% if products|length > 0 %}
            <div class="row row-cards">
                {% for product in products %}
                    <div class="col-sm-6 col-lg-4">
                        <div class="card product-card">
                            <div class="card-img-top img-responsive img-responsive-21x9 jersey-image" 
                                 style="{% if product.image %}background-image: url('{{ product.image }}'); background-size: cover; background-position: center;{% endif %}">
                            </div>
                            <div class="card-body">
                                <h3 class="card-title">{{ product.name }}</h3>
                                <div class="text-muted mb-2">
                                    <strong>{{ product.team }}</strong> - {{ product.season }}
                                </div>
                                {% if product.description %}
                                    <p class="text-muted">{{ product.description|slice(0, 100) }}{% if product.description|length > 100 %}...{% endif %}</p>
                                {% endif %}
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="text-muted">
                                        Size: <strong>{{ product.size }}</strong>
                                    </div>
                                    <div class="text-muted">
                                        Stock: <strong>{{ product.stock }}</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <div class="h2 mb-0">€{{ product.price|number_format(2, '.', ',') }}</div>
                                    </div>
                                    <div class="col-auto">
                                        {% if product.stock > 0 %}
                                            <button class="btn btn-primary" onclick="addToCart({{ product.id }})">
                                                <i class="ti ti-shopping-cart-plus"></i>
                                                Add to Cart
                                            </button>
                                        {% else %}
                                            <button class="btn btn-secondary" disabled>
                                                Out of Stock
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty">
                <div class="empty-img">
                    <img src="data:image/svg+xml;base64," alt="" height="64">
                </div>
                <p class="empty-title">No products found</p>
                <p class="empty-subtitle text-muted">
                    The shop is currently empty. Please check back later or contact the administrator.
                </p>
                <div class="empty-action">
                    <a href="{{ path('admin_dashboard') }}" class="btn btn-primary">
                        <i class="ti ti-plus"></i>
                        Add Products
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}