{% extends 'base.html.twig' %}

{% block title %}Shopping Cart - Football Shop{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    Shopping Cart
                </h2>
                <div class="text-muted mt-1">Review your selected items</div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        {% if cartItems|length > 0 %}
            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Cart Items</h3>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Size</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th class="w-1"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in cartItems %}
                                        <tr>
                                            <td>
                                                <div class="d-flex py-1 align-items-center">
                                                    <span class="avatar me-2" 
                                                          style="{% if item.product.image %}background-image: url('{{ item.product.image }}'); background-size: cover;{% else %}background: linear-gradient(45deg, #f8f9fa 25%, transparent 25%);{% endif %}"></span>
                                                    <div class="flex-fill">
                                                        <div class="font-weight-medium">{{ item.product.name }}</div>
                                                        <div class="text-muted">{{ item.product.team }} - {{ item.product.season }}</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted">
                                                {{ item.product.size }}
                                            </td>
                                            <td class="text-muted">
                                                €{{ item.product.price|number_format(2, '.', ',') }}
                                            </td>
                                            <td>
                                                <div class="input-group" style="width: 120px;">
                                                    <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity({{ item.id }}, {{ item.quantity - 1 }})">-</button>
                                                    <input type="number" class="form-control text-center" value="{{ item.quantity }}" min="1" onchange="updateQuantity({{ item.id }}, this.value)">
                                                    <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity({{ item.id }}, {{ item.quantity + 1 }})">+</button>
                                                </div>
                                            </td>
                                            <td class="font-weight-medium">
                                                €{{ item.totalPrice|number_format(2, '.', ',') }}
                                            </td>
                                            <td>
                                                <button class="btn btn-ghost-danger btn-sm" onclick="removeFromCart({{ item.id }})">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Order Summary</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col">
                                    <div class="text-muted">Items ({{ cartItems|length }})</div>
                                </div>
                                <div class="col-auto">
                                    <div class="text-muted">€{{ total|number_format(2, '.', ',') }}</div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col">
                                    <div class="text-muted">Shipping</div>
                                </div>
                                <div class="col-auto">
                                    <div class="text-muted">Free</div>
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col">
                                    <div class="h3 mb-0">Total</div>
                                </div>
                                <div class="col-auto">
                                    <div class="h3 mb-0">€{{ total|number_format(2, '.', ',') }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="d-grid">
                                <a href="{{ path('checkout') }}" class="btn btn-primary">
                                    <i class="ti ti-credit-card"></i>
                                    Proceed to Checkout
                                </a>
                            </div>
                            <div class="d-grid mt-2">
                                <a href="{{ path('home') }}" class="btn btn-outline-secondary">
                                    <i class="ti ti-arrow-left"></i>
                                    Continue Shopping
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="empty">
                <div class="empty-img">
                    <img src="data:image/svg+xml;base64," alt="" height="64">
                </div>
                <p class="empty-title">Your cart is empty</p>
                <p class="empty-subtitle text-muted">
                    You haven't added any items to your cart yet.
                </p>
                <div class="empty-action">
                    <a href="{{ path('home') }}" class="btn btn-primary">
                        <i class="ti ti-arrow-left"></i>
                        Continue Shopping
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
function updateQuantity(cartItemId, newQuantity) {
    if (newQuantity <= 0) {
        removeFromCart(cartItemId);
        return;
    }

    const formData = new FormData();
    formData.append('cart_item_id', cartItemId);
    formData.append('quantity', newQuantity);

    fetch('/update-cart-quantity', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error updating quantity');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error updating quantity');
    });
}

function removeFromCart(cartItemId) {
    if (!confirm('Remove this item from cart?')) {
        return;
    }

    fetch(`/remove-from-cart/${cartItemId}`, {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            location.reload();
        } else {
            alert('Error removing item');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error removing item');
    });
}
</script>
{% endblock %}